<Window x:Class="TFastFoodProject.Employee.EmployeeManager.OrderDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Order Details"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FAFAFA"
        Height="700" Width="1295">

    <!-- ======= COLOR & STYLE RESOURCES ======= -->
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryColor" Color="#FF6F00"/>
        <SolidColorBrush x:Key="PrimaryDarkColor" Color="#E65100"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FFA000"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#43A047"/>
        <SolidColorBrush x:Key="DangerColor" Color="#E53935"/>
        <SolidColorBrush x:Key="SubTextColor" Color="#888"/>

        <!-- Reusable Button Style -->
        <Style x:Key="AppButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Width" Value="130"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>

            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="5" Opacity="0.25"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- ======= MAIN CONTAINER ======= -->
    <Border CornerRadius="12" Padding="20" Background="White" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" Opacity="0.3"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.5*" />
                <ColumnDefinition Width="1.5*" />
            </Grid.ColumnDefinitions>

            <!-- HÀNG 1 - CỘT 1: FOOD LIST + FILTER -->
            <Border Grid.Row="0" Grid.Column="0" Padding="12" CornerRadius="8" BorderBrush="#DDD" BorderThickness="1">
                <DockPanel>
                    <!-- Header -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="Food List"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryDarkColor}"/>
                        <TextBlock Text="Select items to add to the order."
                                   FontSize="13"
                                   Foreground="{StaticResource SubTextColor}"/>
                    </StackPanel>

                    <!-- Filter -->
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,10">
                        <ComboBox x:Name="cbCategory"
                          Width="150"
                          Height="34"
                          FontSize="14"
                          Margin="0,0,10,0"
                          VerticalAlignment="Center"
                          VerticalContentAlignment="Center"
                          Padding="8,2"
                          BorderBrush="#CCC"
                          BorderThickness="1"
   
          SelectionChanged="cbCategory_SelectionChanged">
                        </ComboBox>

                        <TextBox x:Name="txtSearch"
                                 Width="220"
                                 Height="32"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,10,0"
                                 Padding="8,0"
                                 FontSize="14"
                                 ToolTip="Enter keyword to search"/>

                        <Button x:Name="btnSearch"
                                Content="Search"
                                Style="{StaticResource AppButtonStyle}" Click="btnSearch_Click"/>
                    </StackPanel>

                    <!-- Food DataGrid -->
                    <DataGrid x:Name="dgFoodList"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              FontSize="14"
                              RowHeight="70"
                              AlternatingRowBackground="#FFF9F9F9"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              BorderBrush="#CCC" BorderThickness="1" SelectionChanged="dgFoodList_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Image" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding ImagePath}"
                                               Height="60" Width="60"
                                               Stretch="UniformToFill"
                                               Margin="2"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=N2}" Width="120"/>
                            
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- HÀNG 1 - CỘT 2: ADD FOOD TO ORDER -->
            <Border Grid.Row="0" Grid.Column="1" Padding="15" CornerRadius="8" BorderBrush="#DDD" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Add Food to Order"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryDarkColor}"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="Selected Food:"  FontWeight="SemiBold" />
                    <TextBlock x:Name="FoodNameTextBlock"  Margin="0,4,0,10" Foreground="{StaticResource SubTextColor}"/>
                    <TextBlock Text="Quantity:"/>
                    <TextBox x:Name="txtQuantity"
                             Width="150"
                             Height="32"
                             Margin="0,6,0,12"
                             Padding="6"
                             FontSize="14"
                             VerticalContentAlignment="Center"/>
                    <Button x:Name="btnAddToOrder" Content="Add to Order" Style="{StaticResource AppButtonStyle}" Background="{StaticResource SuccessColor}" Click="btnAddToOrder_Click"/>
                </StackPanel>
            </Border>

            <!-- HÀNG 2 - CỘT 1: ORDER DETAILS -->
            <Border Grid.Row="1" Grid.Column="0" Padding="12" CornerRadius="8" BorderBrush="#DDD" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Order Details"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryDarkColor}"
                               Margin="0,0,0,10"/>
                    <DataGrid x:Name="dgOrderDetail"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              AlternatingRowBackground="#FFF9F9F9"
                              FontSize="14"
                              GridLinesVisibility="None">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Image" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Source="{Binding Food.ImagePath}"
                   Height="60" Width="60"
                   Stretch="UniformToFill"
                   Margin="2"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Food Name" Binding="{Binding Food.Name}" Width="*"/>
                            <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="100"/>
                            <DataGridTextColumn Header="Unit Price" Binding="{Binding Food.Price, StringFormat=N2}" Width="120"/>
                            
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- HÀNG 2 - CỘT 2: ORDER SUMMARY -->
            <Border Grid.Row="1" Grid.Column="1" Padding="15" CornerRadius="8" BorderBrush="#DDD" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Order Summary"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryDarkColor}"
                               Margin="0,0,0,10"/>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                        <TextBlock Text="Order ID:" FontWeight="SemiBold" Width="80"/>
                        <TextBlock x:Name="txtOrderId"  Foreground="{StaticResource SubTextColor}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,16">
                        <TextBlock Text="Total Amount:" FontWeight="SemiBold" Width="100"/>
                        <TextBlock x:Name="txtTotalAmount" Text="0.00"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource SuccessColor}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="btnDeleteSelected" Content="Delete Selected"
                                Style="{StaticResource AppButtonStyle}"
                                Background="{StaticResource DangerColor}" Click="btnDeleteSelected_Click"/>
                        <Button x:Name="btnSaveOrder" Content="Save Order"
                                Style="{StaticResource AppButtonStyle}"
                                Background="{StaticResource PrimaryDarkColor}" Click="btnSaveOrder_Click"/>
                        <Button x:Name="btnBack"
                        Content="← Back"
                        Style="{StaticResource AppButtonStyle}"
                        Background="{StaticResource AccentColor}"
                        Click="btnBack_Click"
                        />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
