<Window x:Class="TFastFoodProject.Admin.AdminManagers.AdminManager.IngredientManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TFastFoodProject"
        mc:Ignorable="d"
        Title="IngredientManagerWindow"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Window.Resources>
        <!-- Color Definitions -->
        <SolidColorBrush x:Key="PrimaryColor" Color="#FF6F00"/>
        <SolidColorBrush x:Key="PrimaryDarkColor" Color="#E65100"/>
        <SolidColorBrush x:Key="SecondaryColor" Color="#4A4A4A"/>
        <SolidColorBrush x:Key="CardBackground" Color="White"/>
        <SolidColorBrush x:Key="SubTextColor" Color="#888888"/>
        <SolidColorBrush x:Key="BackgroundColor" Color="#F5F5F5"/>
        <SolidColorBrush x:Key="BorderColor" Color="#DDDDDD"/>
        <SolidColorBrush x:Key="TextColor" Color="#333333"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#4CAF50"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FFA000"/>

        <!-- Style cho nút sidebar -->
        <Style x:Key="DashboardButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FF9800"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource PrimaryDarkColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- MAIN GRID -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <StackPanel Grid.Column="0" Background="{StaticResource SecondaryColor}">
            <TextBlock Text="TFastFood"
                       Foreground="White"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="20,30,20,40"
                       HorizontalAlignment="Center"/>

            <Button Content="Dashboard" Margin="10,5" Padding="10"
                    HorizontalContentAlignment="Left"
                    Background="Transparent" Foreground="LightGray"
                    FontSize="16" FontWeight="SemiBold"
                    BorderThickness="0"
                    Click="Dashboard_Click"/>

            <Button Content="Employee Manager" Margin="10,5" Padding="10"
                    HorizontalContentAlignment="Left"
                    Background="Transparent" Foreground="LightGray"
                    
                    FontSize="16" BorderThickness="0"
                    Click="Employee_Click"/>

            <Button Content="Ingredient Manager" Margin="10,5" Padding="10"
                    HorizontalContentAlignment="Left"
                    Background="{StaticResource PrimaryColor}"
                    Foreground="White"
                    FontSize="16" BorderThickness="0"/>

            <Button Content="Food Manager" Margin="10,5" Padding="10"
                    HorizontalContentAlignment="Left"
                    Background="Transparent"
                    Foreground="LightGray"
                    FontSize="16"
                    BorderThickness="0"
                    Click="FoodManager_Click"/>

            <Button Content="Logout" Margin="10,5" Padding="10"
                    HorizontalContentAlignment="Left"
                    Background="Transparent" Foreground="LightGray"
                    FontSize="16" BorderThickness="0"
                    Click="Logout_Click"/>
        </StackPanel>

        <!-- MAIN CONTENT -->
        <Grid Grid.Column="1" Background="{StaticResource BackgroundColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="80"/>
                <!-- Gradient Footer -->
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0" Background="White" Padding="20"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{StaticResource BorderColor}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Welcome Back, Admin!"
                               FontSize="24"
                               FontWeight="ExtraBold"
                               Foreground="{StaticResource PrimaryDarkColor}"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1" Text="📅"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource SubTextColor}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="20,0,0,0"/>
                </Grid>
            </Border>

            <!-- MAIN BODY -->
            <Grid Grid.Row="1" Margin="20,30,20,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.3*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: Ingredient List -->
                <Border Background="White" CornerRadius="12" Padding="20" Margin="10,0,10,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.2" Color="#000000"/>
                    </Border.Effect>

                    <StackPanel>
                        <TextBlock Text="Ingredient Stock"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryDarkColor}"
                                   Margin="0 0 0 15"/>

                        <DataGrid x:Name="IngredientDataGrid"
                                  AutoGenerateColumns="False"
                                  FontSize="15" RowHeight="35"
                                  HeadersVisibility="Column"
                                  AlternatingRowBackground="#FFF9F9F9"
                                  GridLinesVisibility="None"
                                  BorderBrush="#DDDDDD" BorderThickness="1"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  SelectionChanged="IngredientDataGrid_SelectionChanged">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Width="2*" Binding="{Binding Name}"/>
                                <DataGridTextColumn Header="Unit" Width="*" Binding="{Binding Unit}"/>
                                <DataGridTextColumn Header="Stock Quantity" Width="*" Binding="{Binding StockQuantity, StringFormat='G29'}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- RIGHT: Ingredient Detail -->
                <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20" Margin="10,0,0,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.2" Color="#000000"/>
                    </Border.Effect>

                    <StackPanel>
                        <TextBlock Text="Ingredient Detail"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryDarkColor}"
                                   Margin="0 0 0 20"/>

                        <StackPanel Orientation="Horizontal" Margin="0 5 0 10">
                            <TextBlock Text="Name" Width="100" FontSize="16" VerticalAlignment="Center" Foreground="{StaticResource TextColor}"/>
                            <TextBox x:Name="IngredientNameTextBox" Width="180" FontSize="16" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0 5 0 10">
                            <TextBlock Text="Unit" Width="100" FontSize="16" VerticalAlignment="Center" Foreground="{StaticResource TextColor}"/>
                            <TextBox x:Name="UnitTextBox" Width="180" FontSize="16" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0 5 0 15">
                            <TextBlock Text="Stock Qty" Width="100" FontSize="16" VerticalAlignment="Center" Foreground="{StaticResource TextColor}"/>
                            <TextBox x:Name="StockQuantityTextBox" Width="180" FontSize="16" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 30 0 0">
                            <Button Content="Refresh" Width="80" Margin="5 0" Padding="10 5"
                                    Background="#2196F3" Foreground="White" FontWeight="SemiBold"
                                    Style="{StaticResource AppButtonStyle}"
                                    BorderThickness="0" Cursor="Hand" Click="Refesh_Click"/>
                            <Button Content="Add" Width="80" Margin="5 0" Padding="10 5"
                                    Background="{StaticResource SuccessColor}" Foreground="White"
                                    Style="{StaticResource AppButtonStyle}"
                                    FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                                    Click="Add_Click"/>
                            <Button Content="Edit" Width="80" Margin="10 0" Padding="10 5"
                                    Background="{StaticResource AccentColor}" Foreground="White"
                                    Style="{StaticResource AppButtonStyle}"
                                    FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"
                                    Click="Edit_Click"/>
                            <Button Content="Delete" Width="80" Margin="5 0" Padding="10 5"
                                    Background="#E53935" Foreground="White" FontWeight="SemiBold"
                                    Style="{StaticResource AppButtonStyle}"
                                    BorderThickness="0" Cursor="Hand" Click="Delete_Click"/>
                        </StackPanel>
                        <StackPanel Margin="0 150 0 0" HorizontalAlignment="Center">
                        <TextBlock Grid.Row="0" Text="🍔" 
FontSize="80"
HorizontalAlignment="Center"
Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="1" Text="TFastFood"
FontSize="30"
FontWeight="Light"
Foreground="{StaticResource SubTextColor}"
Opacity="0.7"
HorizontalAlignment="Center"
Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="2" Text="Serving speed, flavor, and smiles."
   TextAlignment="Center"
   FontSize="16"
   Foreground="{StaticResource SubTextColor}"
   Opacity="0.6"
   TextWrapping="Wrap"
   HorizontalAlignment="Center"
MaxWidth="600"/>

                        <!-- Decorative Line -->
                        <Rectangle Grid.Row="3" Width="100" Height="3" Fill="{StaticResource PrimaryColor}" Margin="0,20,0,0" Opacity="0.5" HorizontalAlignment="Center"/>
                    </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- FOOTER GRADIENT -->
            <Border Grid.Row="2">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FF6F00" Offset="0"/>
                        <GradientStop Color="#FFA000" Offset="0.5"/>
                        <GradientStop Color="#FFB300" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <TextBlock Text="FastFood Drive-Thru Management System"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="White" Margin="0,10,0,0"/>
            </Border>
        </Grid>
    </Grid>
</Window>
