<Window x:Class="TFastFoodProject.Admin.AdminManagers.AdminManager.EmployeeManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TFastFoodProject"
        xmlns:conv="clr-namespace:TFastFoodProject.Converters"
        mc:Ignorable="d"
        Title="EmployeeManagerWindow" 
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        WindowState="Maximized">

    <Window.Resources>
        <!-- Converte -->
        <conv:BoolToStatusConverter x:Key="BoolToStatusConverter"/>
        <!-- Color Definitions (Matching Login Window) -->
        <SolidColorBrush x:Key="PrimaryColor" Color="#FF6F00"/>
        <!-- Bright Orange -->
        <SolidColorBrush x:Key="PrimaryDarkColor" Color="#E65100"/>
        <!-- Dark Orange -->
        <SolidColorBrush x:Key="SecondaryColor" Color="#4A4A4A"/>
        <!-- Dark Gray for Sidebar -->
        <SolidColorBrush x:Key="CardBackground" Color="White"/>
        <SolidColorBrush x:Key="SubTextColor" Color="#888888"/>

        <!-- Global Color Resources -->
        <SolidColorBrush x:Key="BackgroundColor" Color="#F5F5F5"/>
        <SolidColorBrush x:Key="BorderColor" Color="#DDDDDD"/>
        <SolidColorBrush x:Key="TextColor" Color="#333333"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#4CAF50"/>
        <!-- Green for positive metrics -->
        <SolidColorBrush x:Key="AccentColor" Color="#FFA000"/>
        <!-- Accent Orange for secondary button -->

        <!-- Style for Metric Cards (Enhanced) -->
        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="0"/>
            <!-- Padding removed here, added internally for icon/strip placement -->
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="2" Opacity="0.1" BlurRadius="5" Color="#000000"/>
                </Setter.Value>
            </Setter>
            <!-- Thêm hiệu ứng hover mượt mà cho thẻ -->
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect ShadowDepth="4" Opacity="0.2" BlurRadius="8" Color="#000000"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style for Dashboard Buttons (Kept for sidebar use) -->
        <Style x:Key="DashboardButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,15"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Border" 
                            Background="{TemplateBinding Background}" 
                            CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FF9800"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource PrimaryDarkColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <!-- Sidebar Width -->
            <ColumnDefinition Width="*"/>
            <!-- Main Content Area -->
        </Grid.ColumnDefinitions>

        <!-- 1. SIDEBAR (Left Column) -->
        <StackPanel Grid.Column="0" Background="{StaticResource SecondaryColor}">
            <!-- Logo/Title -->
            <TextBlock Text="TFastFood" 
                   Foreground="White" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   Margin="20,30,20,40"
                   HorizontalAlignment="Center"/>

            <!-- Navigation Items (Kept for structure/decoration) -->
            <Button Content="Dashboard" 
                Margin="10,5" 
                Padding="10" 
                HorizontalContentAlignment="Left"
                
                Background="Transparent" 
                Foreground="LightGray"
                FontSize="16"
                FontWeight="SemiBold"
                BorderThickness="0"
                    Click="Dashboard_Click"
               />

            <Button Content="Employee Manager" 
                Margin="10,5" 
                Padding="10" 
                HorizontalContentAlignment="Left"
                Background="{StaticResource PrimaryColor}" 
                Foreground="White"
                FontSize="16"
                BorderThickness="0"
                />

            <Button Content="Ingredient Manager" 
                Margin="10,5" 
                Padding="10" 
                HorizontalContentAlignment="Left"
                Background="Transparent" 
                Foreground="LightGray"
                FontSize="16"
                BorderThickness="0"
                    Click="Ingredient_Click"/>

            <Button Content="Food Manager" 
            Margin="10,5" 
            Padding="10" 
            HorizontalContentAlignment="Left"
            Background="Transparent" 
            Foreground="LightGray"
            FontSize="16"
            BorderThickness="0"
            Click="FoodManager_Click" 
            />

            <Button Content="Logout" 
                Margin="10,5" 
                Padding="10" 
                HorizontalContentAlignment="Left"
                Background="Transparent" 
                Foreground="LightGray"
                FontSize="16"
                BorderThickness="0"
                Click="Logout_Click"/>
            
            
        </StackPanel>

        <!-- 2. MAIN CONTENT (Right Column) -->
        <Grid Grid.Column="1" Background="{StaticResource BackgroundColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Header -->
                <RowDefinition Height="*"/>
                <!-- Main content -->
                <RowDefinition Height="80"/>
                <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- 2.1. HEADER (Welcome Admin) -->
            <Border Grid.Row="0" Background="White" Padding="20" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderColor}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Welcome Back, Admin!" 
                               FontSize="24" 
                               FontWeight="ExtraBold" 
                               Foreground="{StaticResource PrimaryDarkColor}"/>

                    </StackPanel>

                    <!-- Date Text Block -->
                    <TextBlock Grid.Column="1" Text="📅" 
                           VerticalAlignment="Center" 
                           Foreground="{StaticResource SubTextColor}" 
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="20,0,0,0"/>

                </Grid>
            </Border>

        
            <!-- 2.2. MAIN CONTENT AREA (Enhanced for WPF) -->
            <Grid Grid.Row="1" Margin="20,30,20,20" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.3*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: Staff List -->
                <Border Background="White" 
            CornerRadius="12" 
            Padding="20" 
            Margin="10">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.2" Color="#000000"/>
                    </Border.Effect>

                    <StackPanel>
                        <TextBlock Text="Staff List" 
               FontSize="22" 
               FontWeight="Bold" 
               Foreground="{StaticResource PrimaryDarkColor}" 
               Margin="0 0 0 10"/>

                        <!-- Bộ lọc trạng thái -->
                        <StackPanel Orientation="Horizontal" Margin="0 0 0 15" HorizontalAlignment="Right">
                            <TextBlock Text="Status:" 
                   VerticalAlignment="Center" 
                   FontSize="15" 
                   Margin="0 0 10 0"/>
                            <ComboBox x:Name="StatusFilterComboBox" 
                  Width="150" Height="32" 
                  FontSize="15"
                  VerticalContentAlignment="Center"
                                      SelectedIndex="0" SelectionChanged="StatusFilterComboBox_SelectionChanged"
                  >
                                <ComboBoxItem Content="All" IsSelected="True"/>
                                <ComboBoxItem Content="Active"/>
                                <ComboBoxItem Content="Inactive"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Bảng nhân viên -->
                        <DataGrid x:Name="StaffDataGrid"
              AutoGenerateColumns="False"
              FontSize="15"
              RowHeight="35"
              HeadersVisibility="Column"
              AlternatingRowBackground="#FFF9F9F9"
              GridLinesVisibility="None"
              BorderBrush="#DDDDDD"
              BorderThickness="1"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              IsReadOnly="True"
              SelectionChanged="StaffDataGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Username" Width="*" Binding="{Binding Username}"/>
                                <DataGridTextColumn Header="Password" Width="*" Binding="{Binding Password}"/>
                                <DataGridTextColumn Header="Full Name" Width="*" Binding="{Binding FullName}"/>
                                <DataGridTextColumn Header="Phone" Width="*" Binding="{Binding Phone}"/>
                                <DataGridTextColumn Header="Status" Width="*" Binding="{Binding Active, Converter={StaticResource BoolToStatusConverter}}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>

                </Border>

                <!-- RIGHT: Staff Detail -->
                <Border Grid.Column="1" 
            Background="White" 
            CornerRadius="12" 
            Padding="20" 
            Margin="10">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.2" Color="#000000"/>
                    </Border.Effect>

                    <StackPanel>
                        <TextBlock Text="Staff Detail" 
                       FontSize="22" 
                       FontWeight="Bold" 
                       Foreground="{StaticResource PrimaryDarkColor}" 
                       Margin="0 0 0 20"/>

                        <!-- Input Fields -->

                        <StackPanel Orientation="Horizontal" Margin="0 5 0 10">
                            <TextBlock Text="Username" Width="90" FontSize="16" VerticalAlignment="Center"/>
                            <TextBox x:Name="UsernameTextBox"  Width="180" Height="32" FontSize="16" Padding="5" BorderBrush="#CCCCCC"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0 5 0 10">
                            <TextBlock Text="Password" Width="90" FontSize="16" VerticalAlignment="Center"/>
                            <TextBox x:Name="PasswordTextBox" Width="180" Height="32" FontSize="16" Padding="5" BorderBrush="#CCCCCC"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0 5 0 10">
                            <TextBlock Text="Full Name" Width="90" FontSize="16" VerticalAlignment="Center"/>
                            <TextBox x:Name="FullNameTextBox" Width="180" Height="32" FontSize="16" Padding="5" BorderBrush="#CCCCCC"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0 5 0 15">
                            <TextBlock Text="Phone" Width="90" FontSize="16" VerticalAlignment="Center"/>
                            <TextBox x:Name="PhoneTextBox" Width="180" Height="32" FontSize="16" Padding="5" BorderBrush="#CCCCCC"/>
                        </StackPanel>

                        <!-- Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 10 0 20">
                            <Button Content="Refresh" Width="80" Margin="5 0" Padding="10 5"
                Background="#2196F3" Foreground="White" Style="{StaticResource AppButtonStyle}" FontWeight="SemiBold"
                BorderThickness="0" Cursor="Hand" Click="Refesh_Click"/>
                            <Button Content="Add" Width="80" Style="{StaticResource AppButtonStyle}" Margin="5 0" Padding="10 5"
                Background="{StaticResource SuccessColor}" Foreground="White"
                FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="Add_Click"/>
                            <Button Content="Edit" Style="{StaticResource AppButtonStyle}" Width="80" Margin="10 0" Padding="10 5"
                Background="{StaticResource AccentColor}" Foreground="White"
                FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="Edit_Click"/>
                            <Button Content="Inactive" Style="{StaticResource AppButtonStyle}" Width="80" Margin="5 0" Padding="10 5"
                Background="#E53935" Foreground="White"
                FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" Click="Inactive_Click"/>
                        </StackPanel>
                        <Button Content="Deactive Employee" Width="200" Margin="0 10 0 0"
                        Padding="10 8" HorizontalAlignment="Center"
                        Background="{StaticResource PrimaryColor}"
                        Foreground="White" FontWeight="Bold" BorderThickness="0"
                        Style="{StaticResource AppButtonStyle}"
                        Cursor="Hand"
                                Click="Deactive_Click"
                        />
                        <!-- Logo section -->
                        <StackPanel Margin="0 80 0 0" HorizontalAlignment="Center">
                        <TextBlock Grid.Row="0" Text="🍔" 
FontSize="80"
HorizontalAlignment="Center"
Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="1" Text="TFastFood"
FontSize="30"
FontWeight="Light"
Foreground="{StaticResource SubTextColor}"
Opacity="0.7"
HorizontalAlignment="Center"
Margin="0,0,0,10"/>
                        <TextBlock Grid.Row="2" Text="Serving speed, flavor, and smiles."
   TextAlignment="Center"
   FontSize="16"
   Foreground="{StaticResource SubTextColor}"
   Opacity="0.6"
   TextWrapping="Wrap"
   HorizontalAlignment="Center"
MaxWidth="600"/>

                        <!-- Decorative Line -->
                        <Rectangle Grid.Row="3" Width="100" Height="3" Fill="{StaticResource PrimaryColor}" Margin="0,20,0,0" Opacity="0.5" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
            <!-- FOOTER GRADIENT -->
            <Border Grid.Row="2">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FF6F00" Offset="0"/>
                        <GradientStop Color="#FFA000" Offset="0.5"/>
                        <GradientStop Color="#FFB300" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <TextBlock Text="FastFood Drive-Thru Management System"
               VerticalAlignment="Center" HorizontalAlignment="Center"
               FontSize="16" FontWeight="SemiBold"
               Foreground="White" Margin="0,10,0,0"/>
            </Border>



        </Grid>
    </Grid>
</Window>
