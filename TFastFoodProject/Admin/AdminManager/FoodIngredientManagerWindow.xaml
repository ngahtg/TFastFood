<Window x:Class="TFastFoodProject.Admin.AdminManagers.AdminManager.FoodIngredientManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Food Ingredient Manager"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FAFAFA" Height="502" Width="802">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryColor" Color="#FF6F00"/>
        <SolidColorBrush x:Key="PrimaryDarkColor" Color="#E65100"/>
        <SolidColorBrush x:Key="SubTextColor" Color="#888888"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#4CAF50"/>
        <SolidColorBrush x:Key="AccentColor" Color="#FFA000"/>
    </Window.Resources>

    <Border CornerRadius="12" Padding="20" Background="White" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" Opacity="0.3"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="80"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <StackPanel Grid.Row="0" Margin="0 0 0 15">
                <TextBlock x:Name="FoodNameTextBlock"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{StaticResource PrimaryDarkColor}"
                           Margin="0 0 0 5"/>
                <TextBlock Text="Ingredient relationships for this food item."
                           Foreground="{StaticResource SubTextColor}"
                           FontSize="14"/>
            </StackPanel>

            <!-- INGREDIENT LIST -->
            <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1" CornerRadius="8" Padding="10">
                <DataGrid x:Name="FoodIngredientDataGrid"
                          AutoGenerateColumns="False"
                          FontSize="15"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          AlternatingRowBackground="#FFF9F9F9"
                          GridLinesVisibility="None"
                          SelectionMode="Single"
                          SelectionChanged="FoodIngredientDataGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ingredient Name" Width="2*" Binding="{Binding Ingredient.Name}"/>
                        <DataGridTextColumn Header="Unit" Width="*" Binding="{Binding Ingredient.Unit}"/>
                        <DataGridTextColumn Header="Quantity Used" Width="*" Binding="{Binding QuantityUsed}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- CONTROL PANEL -->
            <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0 15 0 15">

                <!-- INPUT FIELDS -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 0 0 10">
                    <TextBlock Text="Ingredient:" Width="90" VerticalAlignment="Center" FontSize="15"/>
                    <ComboBox x:Name="IngredientComboBox" 
                  Width="180" Height="32" Margin="5,0,20,0"
                  FontSize="15" 
                  VerticalContentAlignment="Center"
                  Padding="5,0"/>
                    <TextBlock Text="Quantity:" Width="70" VerticalAlignment="Center" FontSize="15"/>
                    <TextBox x:Name="QuantityUsedTextBox" 
                 Width="100" Height="32" Padding="5"
                 FontSize="15"
                 VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- BUTTONS -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 10 0 0">
                    <Button Content="Add" Style="{StaticResource AppButtonStyle}" Click="Add_Click"/>
                    <Button Content="Edit" Style="{StaticResource AppButtonStyle}" Click="Edit_Click" Margin="20 0 20 0"/>
                    <Button Content="Delete" Style="{StaticResource AppButtonStyle}" Click="Delete_Click"/>
                    <Button Content="Refresh" Style="{StaticResource AppButtonStyle}" Click="Refresh_Click" Margin="20 0 20 0"/>
                    <Button Content="Close" Style="{StaticResource AppButtonStyle}" Click="Close_Click"/>
                </StackPanel>

            </StackPanel>

            <!-- FOOTER GRADIENT -->
            <Border Grid.Row="3" CornerRadius="12">
                
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FF6F00" Offset="0"/>
                        <GradientStop Color="#FFA000" Offset="0.5"/>
                        <GradientStop Color="#FFB300" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <TextBlock Text="FastFood Drive-Thru Management System"
   VerticalAlignment="Center" HorizontalAlignment="Center"
   FontSize="16" FontWeight="SemiBold"
   Foreground="White" Margin="0,10,0,0"/>
            </Border>


        </Grid>
    </Border>
</Window>
